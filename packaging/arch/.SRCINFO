pkgbase = tablelamp-bin
	pkgdesc = Read-only desktop viewer for Parquet, Arrow IPC, CSV and TSV
	pkgver = 0.1.0.alpha.2
	pkgrel = 1
	url = https://github.com/EtienneT/tablelamp
	arch = x86_64
	license = MIT
	depends = glibc>=2.39
	depends = gcc-libs
	depends = fontconfig
	depends = libxcb
	depends = libxkbcommon-x11
	depends = wayland
	depends = vulkan-icd-loader
	depends = xdg-utils
	depends = desktop-file-utils
	depends = shared-mime-info
	optdepends = vulkan-driver: a Vulkan driver suitable for your GPU
	optdepends = ttf-dejavu: fonts for systems without an installed font family
	provides = tablelamp=0.1.0.alpha.2
	conflicts = tablelamp
	conflicts = rowlight
	conflicts = rowlight-bin
	replaces = rowlight-bin
	options = !strip
	options = !debug
	source = https://github.com/EtienneT/tablelamp/releases/download/v0.1.0-alpha.2/tablelamp-0.1.0-alpha.2-linux-x64-cloud.tar.gz
	sha256sums = REPLACE_WITH_VALIDATED_TABLELAMP_ARCHIVE_SHA256

pkgname = tablelamp-bin
